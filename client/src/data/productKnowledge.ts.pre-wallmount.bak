export type Recommendation = {
  product: KnowledgeProduct;
  role: "best" | "alternative" | "upgrade";
};

export type RecommendationSet = {
  recommendations: Recommendation[];
  needsExpertReview: boolean;
  message: string;
};

export function getRecommendations(goal: FinderGoal, answers: Answers): RecommendationSet {
  // Define the question order for each goal (must match ROUTES in Home.tsx)
  // Note: position and measure paths are now dynamic based on selected type
  const questionIdsByGoal = {
    find: (answers: Answers) => {
      if (answers["find-type"] === "electrical") {
        return ["find-type"];
      }
      return ["find-type", "find-depth", "find-trace"];
    },
    measure: (answers: Answers) => {
      if (answers["measure-type"] === "distance") {
        return ["measure-type", "measure-range"];
      } else if (answers["measure-type"] === "moisture") {
        return ["measure-type", "moisture-substrate"];
      } else if (answers["measure-type"] === "temperature") {
        return ["measure-type"];
      }
      return ["measure-type"];
    },
    position: (answers: Answers) => {
      if (answers["position-type"] === "rotary-levels") {
        // Indoor levels don't ask for range, so don't include it in the path key
        if (answers["position-environment"] === "indoor") {
          return ["position-type", "position-environment", "position-accuracy"];
        }
        return ["position-type", "position-environment", "position-accuracy", "position-range"];
      } else if (answers["position-type"] === "laser-levels") {
        // Laser levels: trade → environment → accuracy → coverage
        // For outdoor work, coverage defaults to "reflines" since 360° walls don't exist outdoors
        if (answers["laser-environment"] === "outdoor" && !answers["laser-coverage"]) {
          answers = { ...answers, "laser-coverage": "reflines" };
        }
        return ["laser-trade", "laser-environment", "laser-accuracy", "laser-coverage"];
      } else if (answers["position-type"] === "receivers") {
        // Receivers: just receiver-type
        return ["receiver-type"];
      } else if (answers["position-type"] === "layout") {
        return ["position-type", "layout-environment"];
      } else if (answers["position-type"] === "survey") {
        // Survey type doesn't have environment/range questions (TS01 always)
        return ["position-type"];
      }
      return ["position-type"];
    },
    lasers: (answers: Answers) => {
      // Laser levels use their own question flow
      return ["laser-trade", "laser-environment", "laser-accuracy", "laser-coverage"];
    },
  };

  const questionIds = typeof questionIdsByGoal[goal] === "function"
    ? (questionIdsByGoal[goal] as (a: Answers) => string[])(answers)
    : (questionIdsByGoal[goal] as string[]);
  const path = lookupRecommendationPath(goal, answers, questionIds);

  if (!path) {
    return {
      recommendations: [],
      needsExpertReview: true,
      message: "No verified product matches these requirements. A Laserman expert can help confirm the best fit.",
    };
  }

  // Look up products by ID
  const getProductById = (id: string) => KNOWLEDGE_PRODUCTS.find((p) => p.id === id);

  const bestProduct = getProductById(path.best);
  if (!bestProduct) {
    console.error(`[Product Finder] Product not found: ${path.best}`);
    return {
      recommendations: [],
      needsExpertReview: true,
      message: "No verified product matches these requirements. A Laserman expert can help confirm the best fit.",
    };
  }

  const recommendations: Recommendation[] = [{ product: bestProduct, role: "best" }];

  // Add alternative if defined
  if (path.alternative) {
    const altProduct = getProductById(path.alternative);
    if (altProduct) {
      recommendations.push({ product: altProduct, role: "alternative" });
    }
  }

  // Add upgrade if defined
  if (path.upgrade) {
    const upgradeProduct = getProductById(path.upgrade);
    if (upgradeProduct) {
      recommendations.push({ product: upgradeProduct, role: "upgrade" });
    }
  }

  return {
    recommendations,
    needsExpertReview: bestProduct.confidence === "Expert review",
    message: `This is the best technical fit for your application. See price, specs and compatible accessories below.`,
  };
}
